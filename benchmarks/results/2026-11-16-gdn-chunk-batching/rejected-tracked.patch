+def _prepare_gdn_chunks(q, k, v, g, beta):
+    """Independent FP32 transforms; leading dimensions may include chunks."""
+    cum_decay = g.cumsum(dim=-1)
+    pairwise_decay = cum_decay.unsqueeze(-1) - cum_decay.unsqueeze(-2)
+    size = q.shape[-2]
+    mask = torch.tril(torch.ones(size, size, device=q.device))
+    pairwise_decay = pairwise_decay.masked_fill(mask == 0, float('-inf')).exp()
+    ut_system = (k * beta.unsqueeze(-1)) @ k.transpose(-2, -1) * pairwise_decay
+    intra_chunk_attn = q @ k.transpose(-2, -1) * pairwise_decay
+    v_beta = v * beta.unsqueeze(-1)
+    decayed_k = (k * beta.unsqueeze(-1)) * cum_decay.exp().unsqueeze(-1)
+    v_new = torch.linalg.solve_triangular(ut_system, v_beta, upper=False, unitriangular=True)
+    k_cumdecay = torch.linalg.solve_triangular(ut_system, decayed_k, upper=False, unitriangular=True)
+    return cum_decay, intra_chunk_attn, v_new, k_cumdecay
